# DeepFlow AI — Environment Configuration
# Firebase Firestore is the application database.

PORT=8000
HOST=0.0.0.0

# ──── AI Provider ────
# Options: demo | openai | gemini
AI_PROVIDER=demo
OPENAI_API_KEY=
GEMINI_API_KEY=

# ──── Firebase / Firestore ────
# Set FIREBASE_CREDENTIALS to the JSON contents of your Firebase service-account key.
# Never commit a service-account JSON file or its private key to GitHub.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=
