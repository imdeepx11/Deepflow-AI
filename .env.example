# DeepFlow AI — Environment Configuration
# Copy this file to .env and fill in your values.

# ──── Server Settings ────
PORT=8000
HOST=127.0.0.1

# ──── AI Provider ────
# Options: demo | gemini
# "demo" uses built-in extraction; "gemini" calls Google Gemini API.
AI_PROVIDER=demo

# ──── API Keys ────
# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=

# ──── Database ────
DATABASE_URL=sqlite:///intelliflow.db
