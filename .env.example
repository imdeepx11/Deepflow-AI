# DeepFlow AI — Environment Configuration
# Copy this file to .env and fill in your values.

# ──── Server Settings ────
PORT=8000
HOST=127.0.0.1

# ──── AI Provider Configuration ────
# Options: demo | openai | gemini
# "demo" uses built-in rule extraction engine; "openai" uses GPT-4o; "gemini" uses Gemini 2.5.
AI_PROVIDER=demo

# ──── API Keys ────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ──── Database Settings ────
DATABASE_URL=sqlite:///deepflow.db
