# ========================
# NEXORA AI — .gitignore
# ========================

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.whl

# ----- Virtual Environments -----
venv/
.venv/
env/
backend/venv/

# ----- Environment Variables -----
.env
.env.local
.env.production

# ----- Database -----
*.db
*.sqlite3

# ----- Uploads (user-generated) -----
backend/uploads/*
!backend/uploads/.gitkeep

# ----- Node / Frontend -----
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# ----- IDE / Editor -----
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ----- OS -----
.DS_Store
desktop.ini

# ----- Misc -----
*.bak
*.tmp
